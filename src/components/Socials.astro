---
import Button from "./ui/Button.astro";
import { X, LinkedIn, Instagram, Github, Medium } from "simple-icons-astro";
---

<div class="md:justify-self-end">
  <h2 class="pb-3 text-3xl font-semibold md:text-right">Socials</h2>
  <div class="flex flex-wrap gap-2 md:justify-end">
    <Button aria-label="Twitter" href="https://twitter.com/err_53">
      <X class="size-10" />
    </Button>
    <Button aria-label="LinkedIn" href="https://www.linkedin.com/in/jhuang03/">
      <LinkedIn class="size-10" />
    </Button>
    <Button aria-label="Instagram" href="https://www.instagram.com/the.err53/">
      <Instagram class="size-10" />
    </Button>
    <Button aria-label="Github" href="https://github.com/err53">
      <Github class="size-10" />
    </Button>
    <Button aria-label="Medium" href="https://err53.medium.com/">
      <Medium class="size-10" />
    </Button>
  </div>
</div>
