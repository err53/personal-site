---
import { Picture } from "astro:assets";
import Card from "../ui/Card.astro";

import meetingbot from "../../assets/meetingbot.png";
import dash_banner from "../../assets/dash_banner.png";
import dh_portal from "../../assets/dh_portal.png";
import salesbop from "../../assets/salesbop.png";
import personal_site from "../../assets/personal_site.png";
import cs_wiki from "../../assets/cs_wiki.png";
import oscs from "../../assets/oscs.png";

---

<div class="col-span-full">
  <h2 class="pb-3 text-3xl font-semibold">Projects</h2>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <Card
      href="https://meetingbot.tech/"
      aria-label="meetingbot"
    >
      <Fragment slot="summary">
        <h3 class="text-2xl">meetingbot</h3>
        <p>An open-source meeting bot API deployed on AWS</p>
      </Fragment>
      <Picture src={meetingbot} alt="A screenshot of meetingbot." priority />
    </Card>

    <Card
      href="https://github.com/Krish120003/dash"
      aria-label="Dash"
    >
      <Fragment slot="summary">
        <h3 class="text-2xl">Dash</h3>
        <p>A personalizable new-tab dashboard</p>
      </Fragment>
      <Picture src={dash_banner} alt="A screenshot of Dash." />
    </Card>

    <Card
      href="https://github.com/deltahacks/portal"
      aria-label="DeltaHacks Portal"
    >
      <Fragment slot="summary">
        <h3 class="text-2xl">DeltaHacks Portal</h3>
        <p>A hackathon registration and management system</p>
      </Fragment>
      <Picture src={dh_portal} alt="A screenshot of the DeltaHacks portal." />
    </Card>

    <Card href="https://www.salesbop.io" aria-label="SalesBop">
      <Fragment slot="summary">
        <h3 class="text-2xl">SalesBop</h3>
        <p>
          A comprehensive, customizable sales coaching platform with natural
          language feedback
        </p>
      </Fragment>
      <Picture
        src={salesbop}
        alt="A screenshot of the SalesBop landing page."
      />
    </Card>

    <Card
      href="https://github.com/err53/personal-site"
      aria-label="Personal Site"
    >
      <Fragment slot="summary">
        <h3 class="text-2xl">Personal Site</h3>
        <p>You&apos;re looking at it right now!</p>
      </Fragment>
      <Picture
        src={personal_site}
        alt="A screenshot of this website."
      />
    </Card>

    <Card
      href="https://beta.wiki.egirls.dev/s/public"
      aria-label="McMaster CS Wiki"
    >
      <Fragment slot="summary">
        <h3 class="text-2xl">McMaster CS Wiki</h3>
        <p>
          A repository of course knowledge, notes, and resources.
          <br />
          Currently in the middle of a migration off of Wiki.JS, so things might be
          a little broken...
        </p>
      </Fragment>
      <Picture
        src={cs_wiki}
        alt="A screenshot of the McMaster CS Wiki."
      />
    </Card>

    <Card
      href="https://github.com/mac-egirls/oscs"
      aria-label="Open Source Cheat Sheets"
    >
      <Fragment slot="summary">
        <h3 class="text-2xl">Open Source Cheat Sheets</h3>
        <p>
          A collection of community-built, freely modifiable course cheat sheets
        </p>
      </Fragment>
      <Picture
        src={oscs}
        alt="A screenshot of the Open Source Cheat Sheets preview page."
      />
    </Card>
  </div>
</div>
