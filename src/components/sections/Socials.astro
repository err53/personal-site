---
import Button from "../ui/Button.astro";
import { X, LinkedIn, Instagram, Github, Medium } from "simple-icons-astro";
import { socials, type SocialLabel } from "../../data/profile";

const icons = { X, LinkedIn, Instagram, Github, Medium } satisfies Record<
  SocialLabel,
  unknown
>;
---

<section class="md:justify-self-end" aria-labelledby="socials-heading">
  <h2 id="socials-heading" class="pb-3 text-3xl font-semibold md:text-right">
    Socials
  </h2>
  <div class="flex flex-wrap gap-2 md:justify-end">
    {
      socials.map(({ label, href }) => {
        const Icon = icons[label];
        return (
          <Button aria-label={label} href={href} rel="me">
            <Icon class="size-10" />
          </Button>
        );
      })
    }
  </div>
</section>
