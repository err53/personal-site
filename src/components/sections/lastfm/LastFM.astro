---
import LastFMIsland from "./LastFMIsland";

const profileUrl = "https://www.last.fm/user/err53";
---

<section aria-labelledby="lastfm-heading">
  <h2 id="lastfm-heading" class="pb-3 text-3xl font-semibold">LastFM</h2>
  <LastFMIsland
    client:visible={{ rootMargin: "200px" }}
    profileUrl={profileUrl}
  />
  <p class="pt-2 text-xs text-neutral-500">
    Music data provided by <a class="underline" href={profileUrl}>Last.fm</a>.
  </p>
</section>
