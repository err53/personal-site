---
import LastFMIsland from "./LastFMIsland";

const profileUrl = "https://www.last.fm/user/err53";
---

<section>
  <h2 class="pb-3 text-3xl font-semibold">LastFM</h2>
  <LastFMIsland
    client:idle
    endpoint="/api/lastfm.json"
    profileUrl={profileUrl}
  />
</section>

<style is:global>
  [data-playing="true"] [data-artwork] {
    animation: lastfm-spin 1.8s linear infinite;
  }

  .lastfm-record {
    background-image: repeating-radial-gradient(
      circle,
      transparent 0,
      transparent 5px,
      rgb(64 64 64) 6px
    );
  }

  @keyframes lastfm-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-playing="true"] [data-artwork] {
      animation: none;
    }
  }
</style>
