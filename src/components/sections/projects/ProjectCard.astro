---
import { Picture } from "astro:assets";
import Card from "../../ui/Card.astro";

interface Props {
  href: string;
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  priority?: boolean;
}

const { href, title, description, image, imageAlt, priority = false } =
  Astro.props;
---

<Card {href}>
  <Fragment slot="summary">
    <h3 class="text-2xl">{title}</h3>
    <p>{description}</p>
  </Fragment>
  <Picture src={image} alt={imageAlt} {priority} />
</Card>
