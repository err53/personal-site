---
import ProjectCard from "./ProjectCard.astro";

import salesbop from "../../../assets/salesbop.png";
import meetingbot from "../../../assets/meetingbot.png";
import deltaHacksPortal from "../../../assets/dh_portal.png";
import oscs from "../../../assets/oscs.png";

const projects = [
  {
    href: "https://www.salesbop.io",
    title: "SalesBop",
    description:
      "Co-founded an LLM-powered sales coaching platform acquired by FliteHouse.",
    image: salesbop,
    imageAlt:
      "SalesBop landing page introducing an AI sales coach over faded coaching metrics and customer portraits.",
    priority: true,
  },
  {
    href: "https://meetingbot.tech/",
    title: "meetingbot",
    description:
      "Co-built a self-hosted meeting bot API and grew its open-source developer community.",
    image: meetingbot,
    imageAlt:
      "Diagram connecting Zoom, Microsoft Teams, and Google Meet to recording, transcript, and event outputs.",
    priority: true,
  },
  {
    href: "https://github.com/deltahacks/portal",
    title: "DeltaHacks Platform",
    description:
      "Led the platform used to manage and review 1,000+ hackathon applications.",
    image: deltaHacksPortal,
    imageAlt:
      "Dark DeltaHacks IX login screen with Google, GitHub, Discord, and LinkedIn sign-in options.",
  },
  {
    href: "https://github.com/mac-egirls/oscs",
    title: "Open Source Cheat Sheets",
    description:
      "Community-maintained course references built for open reuse and contribution.",
    image: oscs,
    imageAlt:
      "Cheat sheet browser listing course PDFs beside a multi-page algorithms reference preview.",
  },
];
---

<section class="col-span-full" aria-labelledby="projects-heading">
  <h2 id="projects-heading" class="pb-3 text-3xl font-semibold">Projects</h2>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    {projects.map((project) => <ProjectCard {...project} />)}
  </div>
</section>
