---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<"a">;

const { class: className, ...attrs } = Astro.props;
---

<a
  class:list={[
    "interactive-surface flex h-full flex-col justify-between",
    className,
  ]}
  {...attrs}
>
  <div class="m-6">
    <slot name="summary" />
  </div>
  <slot />
</a>
