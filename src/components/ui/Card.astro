---
interface Props {
  label?: string;
  href: string;
  className?: string;
}

const { label, href, className } = Astro.props;
---

<a
  aria-label={label}
  href={href}
  class:list={[
    "hover:bg-accent hover:text-accent-foreground flex h-full flex-col justify-between border shadow-md transition-all duration-300 active:shadow-none",
    className,
  ]}
>
  <slot />
</a>
